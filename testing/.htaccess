# The testing/ tree is a CLI diagnostic tool and must never be served over
# HTTP: it can write diagnostic logs containing configuration details, and
# testing/external/run.php makes outbound requests to a caller-supplied host.
# See testing/HELP.md and the README for the nginx equivalent of this block
# (nginx does not read .htaccess files).
<IfModule mod_authz_core.c>
    # Apache >= 2.4
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order allow,deny
    Deny from all
</IfModule>
